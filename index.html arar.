<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#080c18">
<meta name="description" content="Official information about ULTRADEJ, an Ethereum-based digital token.">
<title>ULTRADEJ — Official</title>

<style>
:root {
  --bg: #080c18;
  --panel: #121a27;
  --border: #2a3a43;
  --text: #f5f7ff;
  --muted: #b9c2d2;
  --gold: #e7bd73;
  --gold-light: #f5dba8;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--text);
  line-height: 1.65;
  background:
    radial-gradient(ellipse at 82% 0%, #143d32 0%, transparent 38rem),
    #080c18;
}

a {
  color: inherit;
}

.wrap {
  width: min(1050px, calc(100% - 40px));
  margin: auto;
}

.site-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
  padding: 20px 0;
  border-bottom: 1px solid rgba(231,189,115,.24);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand img {
  width: 58px;
  height: 58px;
  object-fit: contain;
  border-radius: 12px;
}

.brand-name {
  color: var(--gold);
  font-size: 24px;
  font-weight: 900;
  letter-spacing: 1.5px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 11px 17px;
  border-radius: 10px;
  border: 1px solid rgba(231,189,115,.65);
  background: linear-gradient(135deg,#f5dba8,#c18b3b);
  color: #17140e;
  font-weight: 800;
  text-decoration: none;
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
}

.button.secondary {
  background: #0c1320;
  color: var(--text);
  border-color: var(--border);
}

.hero {
  padding: 80px 0 60px;
}

.eyebrow {
  display: inline-block;
  padding: 5px 12px;
  border-radius: 999px;
  border: 1px solid rgba(231,189,115,.38);
  color: var(--gold-light);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.7px;
  text-transform: uppercase;
}

h1 {
  margin: 18px 0 12px;
  font-size: clamp(44px,8.5vw,82px);
  line-height: 1.04;
  letter-spacing: -2px;
}

h1 span {
  color: var(--gold);
}

.hero-copy {
  max-width: 700px;
  color: var(--muted);
  font-size: clamp(17px,2.4vw,21px);
}

.actions,
.button-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  margin-top: 24px;
}

section {
  padding: 30px 0;
  scroll-margin-top: 24px;
}

.section-heading {
  margin-bottom: 16px;
}

h2 {
  margin: 0 0 6px;
  font-size: clamp(25px,4vw,34px);
  line-height: 1.2;
}

.section-heading p,
.muted {
  color: var(--muted);
}

.section-heading p {
  margin: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
  gap: 15px;
}

.card {
  min-width: 0;
  margin-top: 12px;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: linear-gradient(145deg,#16212f,#0c1320);
}

.stat-label {
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.stat-value {
  margin: 7px 0 0;
  font-size: 21px;
  font-weight: 800;
  overflow-wrap: anywhere;
}

.contract-box {
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: #0c1320;
}

code {
  color: var(--gold-light);
  overflow-wrap: anywhere;
  word-break: break-word;
}

.social-links {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.social-links a {
  display: inline-flex;
  align-items: center;
  padding: 10px 14px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: #0c1320;
  text-decoration: none;
  font-weight: 700;
}

.social-links a:hover {
  border-color: var(--gold);
  color: var(--gold-light);
}

.notice {
  font-size: 13px;
  color: var(--muted);
}

footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 12px;
  margin-top: 36px;
  padding: 28px 0;
  border-top: 1px solid var(--border);
  color: #8993aa;
}

footer a {
  color: var(--gold-light);
  text-decoration: none;
}

@media(max-width:520px) {
  .wrap {
    width: calc(100% - 28px);
  }

  .brand {
    gap: 8px;
  }

  .brand img {
    width: 46px;
    height: 46px;
  }

  .brand-name {
    font-size: 18px;
  }

  .site-header {
    gap: 8px;
  }

  .site-header > .button {
    padding: 9px 10px;
    font-size: 12px;
  }

  .hero {
    padding-top: 58px;
  }

  .card {
    padding: 18px;
  }

  .button {
    padding: 10px 13px;
  }
}
</style>
</head>

